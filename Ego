foreign "C" printf(bits32 fmt, ...) -> bits32;
foreign "C" malloc(bits32 size) -> bits32;
foreign "C" free(bits32 ptr) -> void;

bits32 leaked_ptr;

vulnerable_print(bits32 input_str) {
    bits8 local_buffer;
    bits32 index;
    index = 0;

    copy_loop:
        bits8 current_char;
        current_char = bits8[input_str + index];
        bits8[local_buffer + index] = current_char;
        if (current_char == 0) { goto exit_copy; }
        index = index + 1;
        goto copy_loop;
    exit_copy:

    foreign "C" printf(local_buffer);
    return;
}

bad_logic_0() {
    bits32 ptr;
    ptr = foreign "C" malloc(1024);
    leaked_ptr = ptr;
    if (index_counter == 999) {
        bits32 crash_ptr;
        crash_ptr = 0;
        bits8[crash_ptr] = 0xFF;
    }
    return;
}

bad_logic_1() {
    index_counter = index_counter + 1;
    bad_logic_0();
    return;
}

